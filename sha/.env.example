# ==============================================================================
# Hira Artisanal E-commerce - Environment Configuration
# ==============================================================================

# Node Environment & Server Port
PORT=8000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 🔥 FIREBASE CONFIGURATION (Phone Auth OTP & Firebase Storage)
# Get these from: Firebase Console -> Project Settings -> General -> Your apps (Web)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ------------------------------------------------------------------------------
# 💳 RAZORPAY PAYMENT GATEWAY
# Get these from: Razorpay Dashboard -> Settings -> API Keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder

# ------------------------------------------------------------------------------
# 📱 SMS GATEWAY (Optional: Fast2SMS API key if using telecom route directly)
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=

